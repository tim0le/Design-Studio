# Anthropic API key — used by lib/claude.js (one-shot edits) and lib/agent.js
# (Claude Agent SDK sessions). Get one from https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: route every agent request to a local Anthropic-compatible proxy
# (e.g. LiteLLM in front of Ollama / vLLM) instead of api.anthropic.com.
# See README_LOCAL_LLM.md for proxy setup. The browser-side Backend picker in
# ⚙ Settings takes precedence over this env var at runtime — this is the
# fallback used by headless ops and any agent calls made without browser
# overrides.
# ANTHROPIC_BASE_URL=http://devbox.local:4000

# Build target: selfhost | serverless. Defaults to selfhost.
#   selfhost   — full Express app: Claude Code agent, live-reload watch, and
#                Marp-CLI / LibreOffice exports (PPTX). Requires the `marp` CLI
#                (and LibreOffice for editable PPTX).
#   serverless — Vercel static + /api functions. The agent, watch, and CLI
#                export routes are NOT mounted; AI editing goes through the
#                direct-API /api/ai-edit function instead.
# STUDIO_TARGET=selfhost

# Port the Express studio server listens on. Defaults to 3000 if unset.
PORT=3000
